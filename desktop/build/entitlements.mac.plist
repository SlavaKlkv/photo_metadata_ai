<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!--
      Hardened runtime без App Sandbox.
      disable-library-validation нужен для динамически dlopen-имых
      библиотек, встроенных PyInstaller-бинарником backend.
      Best-effort: реальная нотаризация с этими entitlements ещё
      не выполнялась.
    -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
